# Windows worker only. Never load this file in the browser or commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
MONITOR_USER_ID=
MONITOR_TIMEZONE=America/Chicago
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# JSON array of canonical calendar IDs. Do not use the alias "primary".
GOOGLE_CALENDAR_IDS=[]
PLAID_ENV=production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
PLAID_ITEM_ID=
# No unofficial Garmin password-based integration is enabled.

# Local AI bridge: use the existing app's project and publishable/anon key.
# The AI bridge does NOT need or use SUPABASE_SECRET_KEY above.
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
OLLAMA_ALLOWED_USER_ID=YOUR_SUPABASE_OWNER_UUID
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BRIDGE_PORT=8787
# Leave blank until `tailscale serve 8787` gives you the real private HTTPS hostname.
OLLAMA_BRIDGE_URL=
OLLAMA_ALLOWED_ORIGINS=https://garoggy.github.io
OLLAMA_TIMEOUT_MS=180000
OLLAMA_MAX_TOKENS=2048
OLLAMA_CONTEXT_TOKENS=16384
# Set OLLAMA_NO_CLOUD=1 in the Windows environment of the Ollama process too.
# Setting it here affects this bridge, not an already-running Ollama app.
OLLAMA_NO_CLOUD=1
